# npm server ports; Docker Compose host ports.
PUBLIC_PORT=3000
ADMIN_PORT=3001
CONTENT_DIR=./dist
STATE_DIR=./state
SITE_CONFIG_FILE=./config/site.json

# GHCR deployment image tag; ignored by local builds and npm scripts.
NOX_WIKI_TAG=latest

# Optional: enable the Vite UI development server (npm run dev:ui).
# Keep the backend origins aligned with ADMIN_PORT when enabling this.
# ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
