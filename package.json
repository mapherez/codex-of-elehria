{
  "name": "nox-wiki-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:public": "node --env-file-if-exists=.env --import tsx apps/server/src/main.ts public",
    "dev:admin": "node --env-file-if-exists=.env --import tsx apps/server/src/main.ts admin",
    "dev:ui": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config vite.config.ts --mode admin",
    "build": "npm run build:server && npm run build:public && npm run build:admin",
    "build:server": "tsup apps/server/src/main.ts --format esm --out-dir build/server --clean",
    "build:public": "vite build --mode public",
    "build:admin": "vite build --mode admin",
    "start": "node --env-file-if-exists=.env build/server/main.js public",
    "admin": "node --env-file-if-exists=.env build/server/main.js admin",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "i18next": "^25.0.0",
    "markdown-it": "^14.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "proper-lockfile": "^4.1.2",
    "svelte": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "phosphor-svelte": "^3.1.0",
    "svelte-check": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
